{
  "judge": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "minScore": 0.7,
    "apiKeyEnv": "OPENAI_API_KEY"
  },
  "mode": "first-pass",
  "pipeline": [
    { "provider": "wikimedia" },
    { "provider": "loc" },
    { "parallel": [
      { "provider": "openverse" },
      { "provider": "unsplash", "apiKeyEnv": "UNSPLASH_ACCESS_KEY" },
      { "provider": "pexels", "apiKeyEnv": "PEXELS_API_KEY" }
    ] },
    { "provider": "generate", "model": "gpt-image-1", "size": "1024x1024", "quality": "medium", "apiKeyEnv": "OPENAI_API_KEY" }
  ]
}
